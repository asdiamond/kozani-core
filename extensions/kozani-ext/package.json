{
  "name": "kozani-ext",
  "displayName": "Kozani Extension",
  "publisher": "kozani",
  "version": "0.0.1",
  "enabledApiProposals": [
    "chatProvider",
    "defaultChatParticipant"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "kozani",
        "name": "Kozani",
        "family": "kozani",
        "version": "1.0",
        "maxInputTokens": 128000,
        "maxOutputTokens": 16384,
        "isDefault": true
      }
    ],
    "chatParticipants": [
      {
        "id": "kozani.chat",
        "name": "Kozani",
        "description": "Kozani chat agent",
        "isDefault": true,
        "commands": [],
        "modes": [
          "agent",
          "ask",
          "edit"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kozani-database",
          "title": "Database Explorer",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "kozani-database": [
        {
          "id": "kozani.connections",
          "name": "Connections",
          "icon": "$(database)",
          "contextualTitle": "Database Connections"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kozani.connections",
        "contents": "No database connections configured.\n[Add Connection](command:kozani-ext.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "kozani-ext.signIn",
        "title": "Kozani: Sign In with GitHub"
      },
      {
        "command": "kozani-ext.signOut",
        "title": "Kozani: Sign Out"
      },
      {
        "command": "kozani-ext.addConnection",
        "title": "Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "kozani-ext.removeConnection",
        "title": "Remove Connection",
        "icon": "$(trash)"
      },
      {
        "command": "kozani-ext.refreshConnections",
        "title": "Refresh Connections",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kozani-ext.addConnection",
          "when": "view == kozani.connections",
          "group": "navigation"
        },
        {
          "command": "kozani-ext.refreshConnections",
          "when": "view == kozani.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kozani-ext.removeConnection",
          "when": "view == kozani.connections && viewItem == connection",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}

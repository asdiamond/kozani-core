{
  "name": "kozani-ext",
  "displayName": "Kozani Extension",
  "publisher": "kozani",
  "version": "0.0.1",
  "enabledApiProposals": [
    "chatProvider",
    "defaultChatParticipant",
    "chatParticipantAdditions"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "activationEvents": [
    "*",
    "onNotebook:kozani-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "id": "Kozani Light",
        "label": "Kozani Light",
        "uiTheme": "vs",
        "path": "./themes/kozani-light.json"
      },
      {
        "id": "Kozani Dark",
        "label": "Kozani Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kozani-dark.json"
      }
    ],
    "configurationDefaults": {
      "files.autoSave": "afterDelay",
      "files.autoSaveDelay": 1000,
      "workbench.activityBar.location": "top",
      "chat.commandCenter.enabled": false,
      "workbench.layoutControl.type": "toggles",
      "workbench.navigationControl.enabled": false,
      "window.commandCenter": false,
      "workbench.statusBar.visible": false,
      "workbench.colorTheme": "Kozani Light"
    },
    "notebooks": [
      {
        "type": "kozani-notebook",
        "displayName": "SQL Notebook",
        "selector": [
          {
            "filenamePattern": "*.sqlbook"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "pgsql",
        "aliases": [
          "PostgreSQL",
          "Postgres",
          "pgsql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pgsql",
        "scopeName": "source.pgsql",
        "path": "./syntaxes/pgsql.tmLanguage.json"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "kozani",
        "name": "Kozani",
        "family": "kozani",
        "version": "1.0",
        "maxInputTokens": 128000,
        "maxOutputTokens": 16384,
        "isDefault": true
      }
    ],
    "chatParticipants": [
      {
        "id": "kozani.chat",
        "name": "Kozani",
        "description": "Kozani chat agent",
        "isDefault": true,
        "commands": [],
        "modes": [
          "agent",
          "ask",
          "edit"
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "kozani.connections",
          "name": "Database Connections",
          "icon": "$(database)",
          "contextualTitle": "Database Connections",
          "order": 0
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kozani.connections",
        "contents": "Open a folder to start using Kozani.\n[Open Folder](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "kozani.connections",
        "contents": "No database connections configured.\n[Add Connection](command:kozani-ext.addConnection)",
        "when": "workspaceFolderCount > 0"
      }
    ],
    "commands": [
      {
        "command": "kozani-ext.signIn",
        "title": "Kozani: Sign In with GitHub"
      },
      {
        "command": "kozani-ext.signOut",
        "title": "Kozani: Sign Out"
      },
      {
        "command": "kozani-ext.addConnection",
        "title": "Add Connection",
        "icon": "$(add)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "kozani-ext.removeConnection",
        "title": "Remove Connection",
        "icon": "$(trash)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "kozani-ext.refreshConnections",
        "title": "Refresh Connections",
        "icon": "$(refresh)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "kozani-ext.newQuery",
        "title": "New Query",
        "icon": "$(file-code)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "kozani-ext.newNotebook",
        "title": "New Kozani Notebook",
        "icon": "$(new-file)",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "kozani-ext.newQueryFromTable",
        "title": "SELECT * FROM this table",
        "icon": "$(play)",
        "enablement": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kozani-ext.newNotebook",
          "when": "view == kozani.connections && workspaceFolderCount > 0",
          "group": "navigation@1"
        },
        {
          "command": "kozani-ext.addConnection",
          "when": "view == kozani.connections && workspaceFolderCount > 0",
          "group": "navigation@2"
        },
        {
          "command": "kozani-ext.refreshConnections",
          "when": "view == kozani.connections && workspaceFolderCount > 0",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "kozani-ext.newNotebook",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kozani-ext.removeConnection",
          "when": "view == kozani.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "kozani-ext.newQuery",
          "when": "view == kozani.connections && viewItem == connection",
          "group": "navigation@1"
        },
        {
          "command": "kozani-ext.newQueryFromTable",
          "when": "view == kozani.connections && viewItem == table",
          "group": "navigation@1"
        },
        {
          "command": "kozani-ext.newQueryFromTable",
          "when": "view == kozani.connections && viewItem == view",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run copy-wasm",
    "watch": "tsc -watch -p ./",
    "copy-wasm": "mkdir -p out/sql/wasm && cp src/sql/wasm/*.wasm out/sql/wasm/"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pgsql-parser": "^17.9.5",
    "web-tree-sitter": "^0.22.6",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^18",
    "@types/pg": "^8.16.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
